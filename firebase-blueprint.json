{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, username, and VIP subscription information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_]+$" },
        "role": { "type": "string", "enum": ["admin", "creator", "subscriber", "free_user"] },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "isVIP": { "type": "boolean" },
        "creatorProfileId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name", "username", "role", "isVIP", "createdAt"]
    },
    "MangaSeries": {
      "title": "MangaSeries",
      "description": "Manga series entity with details, cover image, category list, and moderation status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "titleHindi": { "type": "string", "maxLength": 200 },
        "titleJapanese": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "synopsis": { "type": "string", "maxLength": 2000 },
        "synopsisHindi": { "type": "string", "maxLength": 2000 },
        "coverUrl": { "type": "string", "maxLength": 500 },
        "bannerUrl": { "type": "string", "maxLength": 500 },
        "author": { "type": "string", "maxLength": 100 },
        "artist": { "type": "string", "maxLength": 100 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["ongoing", "completed", "hiatus"] },
        "moderationStatus": { "type": "string", "enum": ["approved", "pending_review", "rejected", "draft"] },
        "reviewerNotes": { "type": "string", "maxLength": 1000 },
        "totalViews": { "type": "number" },
        "totalReads": { "type": "number" },
        "rating": { "type": "number" },
        "releaseYear": { "type": "number" },
        "isExclusive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "synopsis", "author", "creatorId", "moderationStatus", "createdAt"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Chapter containing numbered manga pages and moderation status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "seriesId": { "type": "string", "maxLength": 128 },
        "chapterNumber": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "titleHindi": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "releaseDate": { "type": "string" },
        "isExclusiveVIP": { "type": "boolean" },
        "moderationStatus": { "type": "string", "enum": ["approved", "pending_review", "rejected", "draft"] },
        "reviewerNotes": { "type": "string", "maxLength": 1000 },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" }
      },
      "required": ["id", "seriesId", "chapterNumber", "title", "moderationStatus"]
    },
    "CreatorProfile": {
      "title": "CreatorProfile",
      "description": "Public profile for manga creators with earnings and UPI payout details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "penName": { "type": "string", "maxLength": 100 },
        "handle": { "type": "string", "maxLength": 50 },
        "bio": { "type": "string", "maxLength": 1000 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "followersCount": { "type": "number" },
        "seriesCount": { "type": "number" },
        "totalReads": { "type": "number" },
        "monthlyEarningsInr": { "type": "number" },
        "revenueSharePercent": { "type": "number" },
        "upiId": { "type": "string", "maxLength": 100 },
        "bankAccountHolder": { "type": "string", "maxLength": 100 },
        "verified": { "type": "boolean" },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "userId", "penName", "handle", "monthlyEarningsInr", "revenueSharePercent"]
    },
    "Review": {
      "title": "Review",
      "description": "User review and 5-star rating on a manga series",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "seriesId": { "type": "string", "maxLength": 128 },
        "seriesTitle": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "reviewTitle": { "type": "string", "maxLength": 200 },
        "reviewText": { "type": "string", "maxLength": 2000 },
        "likesCount": { "type": "number" },
        "status": { "type": "string", "enum": ["approved", "flagged", "hidden"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "seriesId", "userId", "rating", "reviewTitle", "reviewText"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/series/{seriesId}": {
      "schema": { "$ref": "#/entities/MangaSeries" },
      "description": "Manga series collection with moderation approval states"
    },
    "/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Chapter collection with individual manga pages"
    },
    "/creators/{creatorId}": {
      "schema": { "$ref": "#/entities/CreatorProfile" },
      "description": "Creator profiles and royalty payout configurations"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Ratings and reviews submitted by readers"
    }
  }
}
