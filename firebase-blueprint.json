{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in MangaWild",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["free_user", "subscriber", "creator", "admin"] },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "isVIP": { "type": "boolean" },
        "creatorProfileId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "email", "role"]
    },
    "Series": {
      "title": "Series",
      "description": "Manga series publication",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "synopsis": { "type": "string", "maxLength": 3000 },
        "coverUrl": { "type": "string", "maxLength": 500 },
        "bannerUrl": { "type": "string", "maxLength": 500 },
        "author": { "type": "string", "maxLength": 100 },
        "artist": { "type": "string", "maxLength": 100 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "genres": { "type": "array" },
        "status": { "type": "string", "enum": ["Ongoing", "Completed", "Hiatus"] },
        "isExclusive": { "type": "boolean" },
        "totalViews": { "type": "number" },
        "totalReads": { "type": "number" },
        "likesCount": { "type": "number" },
        "bookmarkedCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "author", "creatorId"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Chapter belonging to a series",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "seriesId": { "type": "string", "maxLength": 128 },
        "chapterNumber": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "releaseDate": { "type": "string", "maxLength": 50 },
        "isExclusiveVIP": { "type": "boolean" },
        "moderationStatus": { "type": "string", "enum": ["approved", "pending_review", "rejected", "draft"] },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "panels": { "type": "array" }
      },
      "required": ["id", "seriesId", "chapterNumber", "title"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comments and reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "seriesId": { "type": "string", "maxLength": 128 },
        "chapterId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 2000 },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "seriesId", "userId", "content"]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "User chapter progress tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "seriesId": { "type": "string", "maxLength": 128 },
        "chapterId": { "type": "string", "maxLength": 128 },
        "chapterNumber": { "type": "number" },
        "panelIndex": { "type": "number" },
        "totalPanels": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "seriesId", "chapterId"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User bookmarked manga series",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "seriesId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "seriesId"]
    },
    "Admin": {
      "title": "Admin",
      "description": "System administrator designation document",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "verifiedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User account documents keyed by auth UID"
    },
    "/series/{seriesId}": {
      "schema": { "$ref": "Series" },
      "description": "Public manga series catalog"
    },
    "/chapters/{chapterId}": {
      "schema": { "$ref": "Chapter" },
      "description": "Manga chapter data"
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "Comment" },
      "description": "Reader comments and chapter discussions"
    },
    "/users/{userId}/reading_progress/{progressId}": {
      "schema": { "$ref": "ReadingProgress" },
      "description": "Private user reading progress history"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "Bookmark" },
      "description": "User saved library bookmarks"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "Admin" },
      "description": "Designated administrator lookup registry"
    }
  }
}
