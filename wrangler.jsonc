{
  "name": "mangawild",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2025-02-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
