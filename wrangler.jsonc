{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mangawild",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2025-02-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "MANGAWILD_BUCKET",
      "bucket_name": "mangawild-storage"
    }
  ]
}
